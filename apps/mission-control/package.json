{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virgil Mission Control web application. Phase 0: Orbital Foundry and Mind of Virgil spikes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:owner": "vite build --config vite.owner.config.ts && node owner-build/inline.mjs",
    "build:owner:v11": "vite build --config vite.owner.v11.config.ts && node owner-build/inline-v11.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "capture": "tsx e2e/capture-spikes.ts",
    "capture:v11": "tsx e2e/capture-v11.ts",
    "capture:v11:screens": "tsx e2e/capture-v11-screens.ts",
    "verify:owner": "tsx e2e/verify-owner-build.ts",
    "verify:owner:v11": "tsx e2e/verify-owner-build-v11.ts",
    "reproduce:owner": "node owner-build/reproduce.mjs",
    "reproduce:owner:v11": "node owner-build/reproduce-v11.mjs",
    "install:browser": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@virgil/agent-contracts": "workspace:*",
    "@virgil/domain": "workspace:*",
    "@virgil/test-fixtures": "workspace:*",
    "@virgil/visual-language": "workspace:*",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.13.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
