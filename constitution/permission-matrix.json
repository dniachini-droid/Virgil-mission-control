{
  "$comment": "Owner-controlled role permission matrix. Authority layer 2. .claude/agents/*.md must agree with this file; tests in packages/agent-contracts enforce agreement. Tool names are Claude Code tool names. 'writeBoundaries' are the only paths a role may create or modify, and only under an explicit authority grant. Enforcement level per boundary is documented in docs/security/THREAT_MODEL.md.",
  "version": "1.0.0",
  "toolVocabulary": ["Read", "Grep", "Glob", "Bash", "Edit", "Write", "Agent"],
  "roles": [
    {
      "id": "virgil",
      "name": "Virgil",
      "title": "Conductor",
      "kind": "permanent",
      "stage": "orchestration",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Bash", "Agent"],
      "bashPolicy": "read-only-git-and-status",
      "writeBoundaries": [],
      "mayModifyCandidate": false,
      "mayModifyTests": false,
      "mayLaunchStages": true,
      "independentOf": [],
      "prohibited": [
        "scope",
        "plan",
        "build",
        "repair",
        "review",
        "adjudicate",
        "approve_pr",
        "merge",
        "deploy",
        "change_own_authority",
        "start_extra_repair_round_without_owner",
        "treat_builder_report_as_proof",
        "perform_routed_work"
      ],
      "stopConditions": [
        "missing_prerequisite",
        "artifact_mismatch",
        "stall_detected",
        "authority_absent",
        "gate_failed",
        "owner_decision_required"
      ],
      "escalatesTo": "owner",
      "resultSchema": "agent-result",
      "payloadSchema": "run-record"
    },
    {
      "id": "cartographer",
      "name": "Cartographer",
      "title": "Scoper",
      "kind": "permanent",
      "stage": "scope",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Write"],
      "bashPolicy": "none",
      "writeBoundaries": ["docs/product/acceptance/"],
      "mayModifyCandidate": false,
      "mayModifyTests": false,
      "mayLaunchStages": false,
      "independentOf": [],
      "prohibited": [
        "plan_architecture",
        "write_code",
        "invent_missing_material_behaviour",
        "resolve_owner_decisions",
        "expand_scope"
      ],
      "stopConditions": [
        "material_owner_decision_missing",
        "idea_insufficiently_specified",
        "contradiction_with_authority"
      ],
      "escalatesTo": "owner",
      "resultSchema": "agent-result",
      "payloadSchema": "acceptance-contract"
    },
    {
      "id": "architect",
      "name": "Architect",
      "title": "Planner",
      "kind": "permanent",
      "stage": "plan",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Bash", "Write"],
      "bashPolicy": "read-only-git-and-status",
      "writeBoundaries": ["docs/architecture/plans/"],
      "mayModifyCandidate": false,
      "mayModifyTests": false,
      "mayLaunchStages": false,
      "independentOf": [],
      "prohibited": [
        "modify_production_code",
        "modify_tests",
        "expand_approved_scope",
        "resolve_owner_decisions",
        "build"
      ],
      "stopConditions": [
        "acceptance_contract_not_approved",
        "repository_findings_contradict_contract",
        "material_owner_decision_missing",
        "risk_requires_owner_decision"
      ],
      "escalatesTo": "owner",
      "resultSchema": "agent-result",
      "payloadSchema": "implementation-plan"
    },
    {
      "id": "fabricator",
      "name": "Fabricator",
      "title": "Builder",
      "kind": "permanent",
      "stage": "build",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "bashPolicy": "build-test-commit-push-within-worktree",
      "writeBoundaries": ["<assigned-worktree>/<permitted-paths-from-plan-or-repair-contract>"],
      "mayModifyCandidate": true,
      "mayModifyTests": "implementation-tests-only",
      "mayLaunchStages": false,
      "independentOf": [],
      "prohibited": [
        "merge",
        "deploy",
        "review_own_work",
        "change_authority",
        "suppress_or_skip_failures",
        "modify_unrelated_files",
        "modify_files_outside_permitted_paths",
        "resolve_owner_decisions",
        "exceed_repair_contract",
        "force_push",
        "rewrite_reviewed_sha"
      ],
      "stopConditions": [
        "unauthorised_file_boundary",
        "missing_owner_decision",
        "repair_contract_exhausted",
        "required_check_cannot_run",
        "plan_contradicts_repository"
      ],
      "escalatesTo": "virgil",
      "resultSchema": "agent-result",
      "payloadSchema": "candidate-artifact"
    },
    {
      "id": "prover",
      "name": "Prover",
      "title": "Test Engineer",
      "kind": "permanent",
      "stage": "verification",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
      "bashPolicy": "run-checks-and-mutation-controls",
      "writeBoundaries": ["<explicitly-authorised-test-boundary>"],
      "mayModifyCandidate": false,
      "mayModifyTests": "within-authorised-test-boundary",
      "mayLaunchStages": false,
      "independentOf": [],
      "prohibited": [
        "modify_production_behaviour",
        "weaken_or_skip_checks_to_pass",
        "mutate_sealed_candidate",
        "declare_review_verdict",
        "merge",
        "deploy"
      ],
      "stopConditions": [
        "test_boundary_not_granted",
        "required_check_cannot_run",
        "mutation_not_detected_by_suite",
        "candidate_sha_changed_during_verification"
      ],
      "escalatesTo": "virgil",
      "resultSchema": "agent-result",
      "payloadSchema": "machine-verification-result"
    },
    {
      "id": "keeper",
      "name": "Keeper",
      "title": "Independent Reviewer",
      "kind": "permanent",
      "stage": "review",
      "maxTier": "TIER_2",
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "bashPolicy": "read-only-reproduction",
      "writeBoundaries": [],
      "mayModifyCandidate": false,
      "mayModifyTests": false,
      "mayLaunchStages": false,
      "independentOf": ["fabricator", "prover", "architect-of-same-candidate"],
      "prohibited": [
        "modify_candidate",
        "modify_tests",
        "use_builder_reasoning_as_evidence",
        "review_own_work",
        "approve_pr",
        "merge",
        "deploy",
        "adjudicate",
        "invent_findings_without_evidence"
      ],
      "stopConditions": [
        "sha_not_current",
        "verification_incomplete",
        "required_evidence_missing",
        "diff_outside_permitted_paths",
        "independence_violated"
      ],
      "escalatesTo": "virgil",
      "resultSchema": "agent-result",
      "payloadSchema": "review-report"
    },
    {
      "id": "arbiter",
      "name": "Arbiter",
      "title": "Adjudicator",
      "kind": "permanent",
      "stage": "adjudication",
      "maxTier": "TIER_2",
