{
  "name": "virgil-mission-control",
  "private": true,
  "version": "0.0.0",
  "description": "A graphical command centre for governed agentic software development.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:owner && pnpm verify:owner:v11 && pnpm verify:web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:owner": "turbo run build:owner",
    "build:owner:v11": "turbo run build:owner:v11",
    "verify:owner": "turbo run verify:owner",
    "verify:owner:v11": "turbo run verify:owner:v11",
    "virgil:status": "node scripts/virgil-status.mjs",
    "reproduce:owner": "node apps/mission-control/owner-build/reproduce.mjs",
    "reproduce:owner:v11": "node apps/mission-control/owner-build/reproduce-v11.mjs",
    "measure:compression:v11": "node apps/mission-control/asset-pipeline/assess-compression.mjs",
    "verify:web": "turbo run verify:web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
