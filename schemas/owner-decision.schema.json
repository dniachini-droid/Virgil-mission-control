{
  "$id": "https://virgil.local/schemas/owner-decision.schema.json",
  "title": "owner-decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "scope_acceptance",
        "material_product_decision",
        "authority_change",
        "scope_expansion",
        "additional_repair_round",
        "retry_after_failure",
        "merge",
        "deployment",
        "permission_expansion",
        "phase_approval",
        "knowledge_authority"
      ]
    },
    "question": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resumesTo": {
      "type": "string",
      "enum": [
        "BUILDING",
        "BUILDER_REPORTED_COMPLETE",
        "VERIFICATION_INCOMPLETE",
        "READY_FOR_REVIEW",
        "REVIEW_IN_PROGRESS",
        "PASS_WITH_NON_BLOCKING_FINDINGS",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE",
        "REPAIR_AUTHORISED",
        "RE_REVIEW_REQUIRED",
        "SAFE_TO_MERGE",
        "MERGED",
        "DEPLOYED",
        "QUARANTINED",
        "OWNER_DECISION_REQUIRED"
      ]
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "git_object",
              "git_ref",
              "command_output",
              "check_run",
              "file_hash",
              "diff",
              "event",
              "pull_request",
              "raw_source",
              "owner_decision",
              "gate_decision",
              "review_report",
              "adjudication",
              "run_record",
              "wiki_page",
              "schema",
              "code_path",
              "adr"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Locator: SHA, path, event id, PR number, check id, URL-free identifier"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "sha256 content hash"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "description": "A pointer to inspectable machine or structured evidence. Prose is never evidence."
      }
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp with offset"
    },
    "recordPath": {
      "description": "docs/decisions/OD-*.md when recorded as a file",
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "decisionId",
    "kind",
    "question",
    "decision",
    "consequences",
    "appliesTo",
    "decidedAt"
  ]
}
