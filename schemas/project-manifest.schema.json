{
  "$id": "https://virgil.local/schemas/project-manifest.schema.json",
  "title": "project-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "description": "Allowlist entry id, never a raw path or URL"
    },
    "defaultBranch": {
      "type": "string"
    },
    "protectedBranches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowlistEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "governingDecisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Owner decision ids that govern this project"
    },
    "governingKnowledgeNodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Wiki node ids whose principles govern this project"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp with offset"
    }
  },
  "required": [
    "projectId",
    "name",
    "repository",
    "defaultBranch",
    "protectedBranches",
    "allowlistEntryId",
    "governingDecisions",
    "governingKnowledgeNodes",
    "createdAt"
  ]
}
