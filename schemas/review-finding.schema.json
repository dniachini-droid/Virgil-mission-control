{
  "$id": "https://virgil.local/schemas/review-finding.schema.json",
  "title": "review-finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Stable identity; never renumbered"
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "virgil",
            "agent",
            "system",
            "git",
            "github",
            "knowledge_worker"
          ]
        },
        "roleId": {
          "type": "string",
          "enum": [
            "virgil",
            "cartographer",
            "architect",
            "fabricator",
            "prover",
            "keeper",
            "arbiter",
            "domain-verifier",
            "breaker",
            "integrator",
            "interface-keeper",
            "security-sentinel",
            "transport-inspector",
            "performance-examiner"
          ],
          "description": "Agent role identifier from constitution/permission-matrix.json"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocking",
        "major",
        "minor",
        "informational"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "surface": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string"
        }
      ],
      "description": "Exact affected surface"
    },
    "criterionId": {
      "description": "Acceptance criterion or authority concerned",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reproduction": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "git_object",
              "git_ref",
              "command_output",
              "check_run",
              "file_hash",
              "diff",
              "event",
              "pull_request",
              "raw_source",
              "owner_decision",
              "gate_decision",
              "review_report",
              "adjudication",
              "run_record",
              "wiki_page",
              "schema",
              "code_path",
              "adr"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Locator: SHA, path, event id, PR number, check id, URL-free identifier"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "sha256 content hash"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "description": "A pointer to inspectable machine or structured evidence. Prose is never evidence."
      },
      "description": "Reproduction evidence; empty means unsupported"
    },
    "status": {
      "type": "string",
      "enum": [
        "raised",
        "reproduced",
        "rejected_unsupported",
        "consolidated",
        "repaired",
        "verified_repaired",
        "non_blocking_persisted"
      ]
    },
    "consolidatedInto": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "injectionAttempt": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "findingId",
    "raisedBy",
    "severity",
    "blocking",
    "surface",
    "title",
    "description",
    "reproduction",
    "status"
  ]
}
