{
  "$id": "https://virgil.local/schemas/evidence-ref.schema.json",
  "title": "evidence-ref",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "git_object",
        "git_ref",
        "command_output",
        "check_run",
        "file_hash",
        "diff",
        "event",
        "pull_request",
        "raw_source",
        "owner_decision",
        "gate_decision",
        "review_report",
        "adjudication",
        "run_record",
        "wiki_page",
        "schema",
        "code_path",
        "adr"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "Locator: SHA, path, event id, PR number, check id, URL-free identifier"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 content hash"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "ref"
  ],
  "description": "A pointer to inspectable machine or structured evidence. Prose is never evidence."
}
