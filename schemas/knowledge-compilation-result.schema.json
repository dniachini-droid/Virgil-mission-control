{
  "$id": "https://virgil.local/schemas/knowledge-compilation-result.schema.json",
  "title": "knowledge-compilation-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "appliedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO-8601 timestamp with offset"
    },
    "approvedBy": {
      "type": "string",
      "enum": [
        "verification",
        "owner"
      ]
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "updatedNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "createdTetherIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "contestedClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "supersededClaimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "rawSourcesUnchanged": {
      "type": "boolean",
      "const": true,
      "description": "Compilation never alters a raw source"
    }
  },
  "required": [
    "proposalId",
    "appliedAt",
    "approvedBy",
    "createdNodeIds",
    "updatedNodeIds",
    "createdTetherIds",
    "contestedClaimIds",
    "supersededClaimIds",
    "rawSourcesUnchanged"
  ]
}
